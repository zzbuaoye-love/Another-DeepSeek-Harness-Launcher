<Page x:Class="AnotherDSHL.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Dark">
    <Page.Resources>
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#14000000" />
        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#14000000" />
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="White" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="White" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="White" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#DDDDDD" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#DDDDDD" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#BBBBBB" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#BBBBBB" />
    </Page.Resources>
    <NavigationView x:Name="ShellNavigation"
                    Background="#99090909"
                    PaneDisplayMode="LeftCompact" CompactPaneLength="48"
                    OpenPaneLength="180" IsPaneOpen="False"
                    IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" AlwaysShowHeader="False"
                    IsTitleBarAutoPaddingEnabled="True"
                    SelectionChanged="ShellNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" Content="启动" Tag="home">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/house.svg" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="WorkspaceItem" Content="工作区" Tag="workspaces">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/folder-open.svg" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="PluginsItem" Content="插件" Tag="plugins">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/puzzle.svg" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="PacksItem" Content="整合包" Tag="packs">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/package.svg" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="EnvironmentItem" Content="运行环境" Tag="environment">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/monitor.svg" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="LogsItem" Content="日志" Tag="logs">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/scroll-text.svg" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="DocsItem" Content="文档" Tag="docs">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/book-open.svg" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SettingsItem" Content="设置" Tag="appearance">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/settings.svg" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AboutItem" Content="关于" Tag="about">
                <NavigationViewItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/info.svg" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Margin="0,32,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="HomeView" Margin="30,0,30,24">
                <ComboBox x:Name="LaunchModeComboBox" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,14,0,0" MinWidth="112" Height="32" FontSize="12"
                          AutomationProperties.Name="启动方式" SelectionChanged="LaunchModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="常规版" Tag="web" />
                    <ComboBoxItem Content="桌面版" Tag="desktop" />
                </ComboBox>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="420" Spacing="0">
                    <Image x:Name="BrandLogo" Source="ms-appx:///Assets/AppIconBlackTile.svg"
                           Width="72" Height="72" HorizontalAlignment="Center" />
                    <TextBlock x:Name="BrandTitle" Text="AnotherDSHL" FontSize="27"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                    <TextBlock x:Name="BrandSubtitle" Text="Yet Another Deepseek Harness Launcher"
                               FontSize="12" Foreground="#A6FFFFFF" HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0" Spacing="8">
                        <StackPanel x:Name="WebLaunchButtons" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="LaunchButton" Content="启动 Web 版" Click="LaunchButton_Click"
                                Width="158" Height="40" Background="White" Foreground="#171717" />
                        <Button x:Name="OpenWebButton" Content="打开界面" Click="OpenWebButton_Click"
                                Visibility="Collapsed" IsEnabled="False" Height="40" />
                        </StackPanel>
                        <Button x:Name="DesktopHomeButton" Content="安装桌面版" Click="DesktopHomeButton_Click"
                                Width="158" Height="40" Background="White" Foreground="#171717"
                                Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel x:Name="WebStatusPanel" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,18,0,0">
                        <ProgressRing x:Name="LaunchProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                        <TextBlock x:Name="ServiceStatusText" Text="本地服务未启动" FontSize="12"
                                   Foreground="#B6FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="PackActivationPanel" Visibility="Collapsed" Spacing="4" Margin="0,8,0,0">
                        <TextBlock x:Name="PackActivationText" Text="尚未验证整合包" FontSize="10" TextWrapping="Wrap"
                                   Foreground="#B6FFFFFF" MaxWidth="380" HorizontalAlignment="Center" />
                        <Button Content="检查整合包" Click="VerifyActivePack_Click" HorizontalAlignment="Center"
                                FontSize="11" Padding="8,3" />
                    </StackPanel>
                    <TextBlock x:Name="DesktopHomeStatusText" Text="正在检测官方桌面客户端…" FontSize="11"
                               Foreground="#B6FFFFFF" HorizontalAlignment="Center" Margin="0,18,0,0"
                               TextWrapping="Wrap" MaxWidth="400" Visibility="Collapsed" />
                </StackPanel>

                <Grid x:Name="WebHomeFooter" VerticalAlignment="Bottom" ColumnSpacing="10" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="WorkspaceTile" Click="EnvironmentButton_Click"
                            HorizontalAlignment="Left" Padding="12,9"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            AutomationProperties.Name="管理工作区">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="ms-appx:///Assets/Icons/folder-open.svg" Width="19" Height="19" />
                            <StackPanel Spacing="1">
                                <TextBlock x:Name="WorkspaceNameText" Text="工作目录"
                                           FontSize="12" FontWeight="SemiBold"
                                           MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="当前工作区" FontSize="10" Foreground="#8FFFFFFF" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="VersionTile" Grid.Column="1" Padding="12,9"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" AutomationProperties.Name="选择启动版本">
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel x:Name="HomeVersionPanel" Width="290" Spacing="8">
                                    <TextBlock Text="启动版本" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="DshVersionComboBox" HorizontalAlignment="Stretch" Height="32" FontSize="12"
                                                  AutomationProperties.Name="DSH 启动版本" SelectionChanged="DshVersionComboBox_SelectionChanged" />
                                        <Button Grid.Column="1" Content="刷新" Height="32" FontSize="11" Click="RefreshDshVersionsButton_Click" />
                                    </Grid>
                                    <TextBlock x:Name="DshVersionStatusText" Text="默认模式：启动前更新到最新版" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="18" />
                            <StackPanel Spacing="1">
                                <TextBlock x:Name="HomeVersionText" Text="默认 · 最新版" FontSize="12" FontWeight="SemiBold"
                                           MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="启动版本" FontSize="10" Foreground="#8FFFFFFF" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Border x:Name="EnvironmentWarning" Grid.Row="1" Grid.ColumnSpan="3" VerticalAlignment="Center"
                            Background="#1DFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                            CornerRadius="6" Padding="11,8" Visibility="Collapsed">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="EnvironmentWarningIcon" Glyph="&#xE7BA;" FontSize="15"
                                      Foreground="#EDE7DA" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="EnvironmentWarningTitle" Text="环境未就绪"
                                               FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LaunchStepPercentText" Text=""
                                               FontSize="10" Foreground="#BFFFFFFF"
                                               HorizontalAlignment="Right" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="EnvironmentWarningText" Text="正在检测…"
                                           FontSize="10" Foreground="#BFFFFFFF"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressBar x:Name="LaunchStepProgressBar" Minimum="0" Maximum="100" Value="0"
                                             Height="3" Margin="0,3,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="WarningRepairButton" Grid.Column="2" Content="解决"
                                    Click="RepairNodeButton_Click" Visibility="Collapsed"
                                    MinWidth="48" Height="28" Padding="8,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="WorkspacesView" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <StackPanel Margin="24,20,24,32" Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="工作区" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="管理项目目录。切换工作区时自动恢复它的版本和整合包。" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkspacePathInput" PlaceholderText="输入项目目录的完整路径" AutomationProperties.Name="添加工作区路径" />
                        <Button Grid.Column="1" Content="添加" Click="AddWorkspace_Click" />
                        <Button Grid.Column="2" Content="浏览…" Click="BrowseButton_Click" />
                    </Grid>
                    <TextBlock x:Name="WorkspaceManagerStatusText" Text="上次选择会自动记住，移除记录不会删除项目文件。"
                               FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="WorkspacesList" SelectionMode="Single" SelectionChanged="WorkspacesList_SelectionChanged"
                              MaxHeight="230" AutomationProperties.Name="已保存的工作区">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="3" Margin="4,8" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Availability}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Configuration}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="RemoveWorkspaceButton" Content="从列表移除当前工作区" Click="RemoveWorkspace_Click" HorizontalAlignment="Left" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="当前工作区的启动配置" FontWeight="SemiBold" />
                            <TextBlock x:Name="WorkspaceConfigurationText" FontSize="12" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="WorkspaceIsolationToggle" Header="版本隔离 · 独立 Harness"
                                          OnContent="独立" OffContent="共享" Toggled="WorkspaceIsolation_Toggled" />
                            <TextBlock x:Name="WorkspaceIsolationDescription" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="HomePackComboBox" Header="整合包" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="启动实例" SelectionChanged="HomePackComboBox_SelectionChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="选择启动版本" Click="WorkspaceVersion_Click" />
                                <Button Content="运行环境" Click="OpenEnvironment_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock Text="自动化" FontWeight="SemiBold" />
                        <ToggleSwitch x:Name="WorkspaceRestoreToggle" Header="切换时恢复版本和整合包" Toggled="WorkspaceAutomation_Toggled" />
                        <ToggleSwitch x:Name="WorkspaceDiscoverToggle" Header="打开工作区页面时发现常用项目" Toggled="WorkspaceAutomation_Toggled" />
                        <TextBlock Text="自动记住上次选择，打开页面时检查所有路径。仅扫描常见位置的一层目录。" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="DiscoverWorkspacesButton" Content="查找项目" Click="DiscoverWorkspaces_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="DiscoveredWorkspacesStatusText" Text="候选项目会显示在这里，点击后添加并切换。" FontSize="12" TextWrapping="Wrap" />
                        <ListView x:Name="DiscoveredWorkspacesList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="DiscoveredWorkspacesList_ItemClick"
                                  MaxHeight="210" AutomationProperties.Name="发现的项目">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,8" Spacing="3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="EnvironmentView" Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch">
                <StackPanel Margin="24,20,24,32"
                            HorizontalAlignment="Stretch" Spacing="24">
                    <StackPanel Spacing="4">
                        <TextBlock Text="运行环境" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="配置 Node.js、下载源及本地服务。项目目录在工作区页面管理。"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Node.js" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WorkspaceTextBox" Header="目录路径"
                                             PlaceholderText="选择项目文件夹" IsReadOnly="True"
                                             TextChanged="WorkspaceTextBox_TextChanged" />
                                    <Button Grid.Column="1" Content="管理工作区" Click="EnvironmentButton_Click"
                                            VerticalAlignment="Bottom" />
                                </Grid>
                                <TextBlock x:Name="WorkspaceHint" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Margin="0,8,0,4" />
                                <TextBlock Text="Node.js 来源" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton x:Name="AutoNodeRadio" Content="自动检测"
                                                 GroupName="NodeMode" Checked="NodeModeRadio_Checked" />
                                    <RadioButton x:Name="ManualNodeRadio" Content="手动选择"
                                                 GroupName="NodeMode" Checked="NodeModeRadio_Checked" />
                                </StackPanel>
                                <TextBlock x:Name="AutoNodePathText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel x:Name="ManualNodePicker" Spacing="8" Visibility="Collapsed">
                                    <Button Content="选择 node.exe" Click="SelectNodeButton_Click"
                                            HorizontalAlignment="Left" />
                                    <TextBlock x:Name="NodePathText" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="NodeSelectionStatusText" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="DSH 运行环境" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <Button Content="刷新" Click="RefreshButton_Click" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Node.js" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="NodeStatusText" Text="检测中…"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                    <Button x:Name="NodeRepairButton" Content="解决 Node.js 问题"
                                            Click="RepairNodeButton_Click" Visibility="Collapsed"
                                            HorizontalAlignment="Left" />
                                    <TextBlock x:Name="NodeRepairStatusText" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="8">
                                    <TextBlock Text="npx" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="NpxStatusText" Text="检测中…"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="8">
                                    <TextBlock Text="DeepSeek Harness" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="WorkspaceDshText" Text="检测中…"
                                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="npm 下载源" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <ComboBox x:Name="NpmRegistryComboBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="NpmRegistryComboBox_SelectionChanged">
                                    <ComboBoxItem Content="自动 · 选择延迟最低的可用源" Tag="Auto" />
                                    <ComboBoxItem Content="阿里 · npmmirror" Tag="Aliyun" />
                                    <ComboBoxItem Content="npm 官方" Tag="Official" />
                                    <ComboBoxItem Content="自定义 HTTPS 源" Tag="Custom" />
                                </ComboBox>
                                <TextBox x:Name="NpmRegistryUrlTextBox" Header="自定义 registry 地址" Visibility="Collapsed"
                                         PlaceholderText="https://registry.example.com/" />
                                <Button Content="检测并保存" Click="CheckNpmRegistry_Click" HorizontalAlignment="Left" />
                                <TextBlock x:Name="NpmRegistryStatusText" Text="应用于 DSH、插件和整合包依赖；下载失败回退 npm 官方源。"
                                           TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="官方桌面客户端" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border x:Name="DesktopClientCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="DesktopClientStatusText" Text="正在检测…"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="桌面版自带运行环境。工作区、账户与更新可在官方客户端中设置。"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="DesktopClientPathText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="DesktopLaunchButton" Content="启动桌面版" Click="DesktopLaunchButton_Click"
                                            IsEnabled="False" />
                                    <Button x:Name="DesktopInstallButton" Content="下载安装" Click="DesktopInstallButton_Click" />
                                    <Button Content="刷新检测" Click="RefreshDesktopButton_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="DesktopSelectButton" Content="选择已安装的程序…" Click="SelectDesktopButton_Click" />
                                    <Button Content="官方网站" Click="DesktopWebsiteButton_Click" />
                                </StackPanel>
                                <ProgressBar x:Name="DesktopInstallProgressBar" Visibility="Collapsed" IsIndeterminate="False" />
                                <TextBlock x:Name="DesktopInstallStatusText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Button x:Name="DesktopCancelInstallButton" Content="取消下载" Click="CancelDesktopInstallButton_Click"
                                        HorizontalAlignment="Left" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PluginsView" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,18,32,24">
                    <StackPanel x:Name="PluginCatalogView" Spacing="8">
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="插件" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock x:Name="CatalogStatusText" Text="正在获取云端插件…" FontSize="11"
                                           Foreground="#AFFFFFFF" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="RefreshCatalogButton" Content="刷新" Click="RefreshCatalogButton_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,1">
