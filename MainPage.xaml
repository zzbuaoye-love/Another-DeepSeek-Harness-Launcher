                               FontSize="12" Foreground="#AFFFFFFF" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="DocsBackButton" Grid.Column="1" Content="后退"
                            Click="DocsBackButton_Click" IsEnabled="False" />
                    <Button x:Name="DocsForwardButton" Grid.Column="2" Content="前进"
                            Click="DocsForwardButton_Click" IsEnabled="False" />
                    <Button Grid.Column="3" Content="首页" Click="DocsHomeButton_Click" />
                </Grid>
                <Border Grid.Row="2" CornerRadius="8" Background="#1AFFFFFF"
                        BorderBrush="#26FFFFFF" BorderThickness="1">
                    <WebView2 x:Name="DocsBrowser"
                              NavigationCompleted="DocsBrowser_NavigationCompleted" />
                </Border>
            </Grid>

            <ScrollViewer x:Name="AboutView" Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,32" Spacing="24" MaxWidth="640"
                            HorizontalAlignment="Stretch">
                    <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="ms-appx:///Assets/AppIconBlackTile.svg"
                                       Width="56" Height="56" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="AnotherDSHL"
                                               Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Yet Another Deepseek Harness Launcher"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                <TextBlock x:Name="AboutVersionText"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Powered By ZZBuAoYe"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock Text="用于启动和管理本机 DeepSeek Harness 的 Windows 桌面应用"
                                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Text="启动器更新" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AppUpdateStatus" Text="检查新版本，或选择本地更新包。" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                <CheckBox x:Name="AppUpdatePrereleaseCheckBox" Content="包含测试版本" FontSize="12" />
                                <ProgressBar x:Name="AppUpdateProgress" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="CheckAppUpdateButton" Content="检查更新" Click="CheckAppUpdate_Click" />
                                    <Button x:Name="LocalAppUpdateButton" Content="安装本地更新包" Click="LocalAppUpdate_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="InstallPreparedAppUpdateButton" Content="安装已下载更新" Click="InstallPreparedAppUpdate_Click" Visibility="Collapsed" />
                                    <Button x:Name="CancelAppUpdateButton" Content="取消" Click="CancelAppUpdate_Click" Visibility="Collapsed" />
                                    <HyperlinkButton Content="发布页面" Click="AppReleases_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="使用说明" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="官方使用说明可在左侧“文档”页面中直接阅读"
                                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                <Button Content="查看文档" Click="AboutDocsButton_Click"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="开源与反馈" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                                <Run Text="本应用开源，源代码托管在 GitHub 仓库中，欢迎提交 issue 或 pull request," />
                                <LineBreak />
                                <Run Text="喜欢的话请点个 star ⭐" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                <Button Content="项目仓库" Click="AboutProjectGitHub_Click" />
                                <Button Content="开发者 GitHub" Click="AboutDeveloperGitHub_Click" />
                            </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <InfoBar Title="第三方项目" Severity="Informational" IsOpen="True" IsClosable="False"
                             Message="本项目隶属于第三方开发者，与 DeepSeek 官方无直接关系，使用时请注意风险" />
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="DemoControls" Visibility="Collapsed" VerticalAlignment="Top"
                    HorizontalAlignment="Right" Margin="16,12,16,0" Padding="10,6"
                    CornerRadius="8" Background="#EE22242A" BorderBrush="#55FFFFFF" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="DemoStepText" Text="演示模式" VerticalAlignment="Center"
                               FontSize="11" Foreground="#DDFFFFFF" />
                    <Button Content="上一步" Click="DemoPrevious_Click" Padding="8,3" />
                    <Button Content="下一步" Click="DemoNext_Click" Padding="8,3" />
                </StackPanel>
            </Border>
        </Grid>
    </NavigationView>
</Page>
