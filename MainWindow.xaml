<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AnotherDSHL.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AnotherDSHL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AnotherDSHL · ADL"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <Frame x:Name="RootFrame" Background="Transparent" />
        <Grid x:Name="WindowDragRegion" Height="32" Margin="48,0,140,0"
              VerticalAlignment="Top" Background="Transparent" Canvas.ZIndex="1" />
        <Image x:Name="CornerAppLogo" Source="ms-appx:///Assets/AppIconLight.svg"
               Width="26" Height="26" Margin="64,3,0,0" HorizontalAlignment="Left"
               VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"
               Canvas.ZIndex="2" />
    </Grid>
</Window>
